    },
    {
      "id": "2c7A9Crv_W5X7q8vYDJ3n",
      "type": "text",
      "x": -1135.390368866095,
      "y": 504.5885405006512,
      "width": 1701.3333333333335,
      "height": 800,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
